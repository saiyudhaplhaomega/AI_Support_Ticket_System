{
  "name":"workflow.noavia-source-library.v1",
  "active":false,
  "nodes":[
    {"id":"sl-001","name":"Receive Source Library Read","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-480,0],"parameters":{"httpMethod":"POST","path":"noavia/source-library/v1","responseMode":"responseNode","authentication":"headerAuth","options":{}},"webhookId":"noavia-source-library-v1"},
    {"id":"sl-002","name":"Validate Source Library Read","type":"n8n-nodes-base.code","typeVersion":2,"position":[-240,0],"onError":"continueErrorOutput","parameters":{"jsCode":"const i=$json.body??$json,a=String(i.action??''),c=String(i.collection??''),s=String(i.source??'').trim();if(!['list','read'].includes(a)||!['ticket','public','admin'].includes(c)||(a==='read'&&(!s||s!==s.split(/[\\\\/]/).pop())))throw new Error('Invalid source-library request.');return[{json:{action:a,collection_alias:c,source:s}}];"}},
    {"id":"sl-003","name":"Read Canonical Sources","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[0,0],"alwaysOutputData":true,"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"value":"noavia_source_documents_v2","mode":"name"},"matchType":"allConditions","filters":{},"returnAll":true,"options":{}}},
    {"id":"sl-004","name":"Build Source Library Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0],"parameters":{"jsCode":"const r=$('Validate Source Library Read').item.json;const rows=$input.all().map(i=>i.json).filter(x=>x.collection_alias===r.collection_alias&&x.index_status!=='retired');if(r.action==='read'){const row=rows.find(x=>x.source===r.source);if(!row)throw new Error('Source document was not found.');return[{json:{ok:true,data:{action:'read',collection:r.collection_alias,source:row.source,content:row.content,version:row.version,updated_at:row.updated_at}}}];}return[{json:{ok:true,data:{action:'list',collection:r.collection_alias,documents:rows.map(x=>({source:x.source,version:x.version,updated_at:x.updated_at})).sort((a,b)=>a.source.localeCompare(b.source))}}}];"}},
    {"id":"sl-005","name":"Respond Source Library Read","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[480,0],"parameters":{"respondWith":"json","responseBody":"={{ $json }}","options":{"responseCode":200}}},
    {"id":"sl-006","name":"Build Source Library Error","type":"n8n-nodes-base.code","typeVersion":2,"position":[0,-180],"parameters":{"jsCode":"return[{json:{ok:false,error:{message:String($json.error?.message??'Source library request failed.')}}}];"}},
    {"id":"sl-007","name":"Respond Source Library Error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[240,-180],"parameters":{"respondWith":"json","responseBody":"={{ $json }}","options":{"responseCode":400}}}
  ],
