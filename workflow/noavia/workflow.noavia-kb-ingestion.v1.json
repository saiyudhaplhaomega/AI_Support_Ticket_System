{
  "name": "workflow.noavia-kb-ingestion.v1",
  "nodes": [
    {
      "parameters": {},
      "id": "noavia-kb-001",
      "name": "Manual Trigger - Ingest NOAVIA KB",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-720, 80]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/noavia/*.md",
        "options": { "dataPropertyName": "data" }
      },
      "id": "noavia-kb-002",
      "name": "Load NOAVIA Knowledge Files",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [-496, 80]
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "allInputData",
        "loader": "textLoader",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "source", "value": "={{ $binary.data.fileName }}" },
              { "name": "collection", "value": "noavia_kb_v1" }
            ]
          }
        }
      },
      "id": "noavia-kb-003",
      "name": "Document Loader - KB Markdown",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [-256, 224]
    },
    {
      "parameters": {
        "chunkSize": 800,
        "chunkOverlap": 120,
        "options": { "splitCode": "markdown" }
      },
      "id": "noavia-kb-007",
      "name": "Recursive Character Text Splitter - 800/120",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [-32, 304]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": { "__rl": true, "value": "noavia_kb_v1", "mode": "id" },
        "options": { "contentPayloadKey": "page_content", "metadataPayloadKey": "metadata" }
      },
      "id": "noavia-kb-004",
      "name": "Qdrant Vector Store - Add Documents",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [0, 80],
      "credentials": { "qdrantApi": { "id": "ErnjnpPFL91PNefY", "name": "Qdrant account" } }
    },
    {
      "parameters": { "model": "text-embedding-3-small", "options": { "dimensions": 1536 } },
      "id": "noavia-kb-005",
      "name": "Embeddings OpenAI - text-embedding-3-small",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [16, 304],
      "credentials": { "openAiApi": { "id": "XnFuXdyk9ZeJLNbi", "name": "OpenAI account" } }
    },
    {
      "parameters": {
        "jsCode": "const source = $binary?.data?.fileName ?? 'unknown';\nconst record = { ts: new Date().toISOString(), module: 'noavia.kb-ingestion', interface_id: 'workflow.noavia-kb-ingestion.v1', version: '1', level: 'info', message: `Indexed ${source} in noavia_kb_v1` };\nconsole.log(JSON.stringify(record));\nreturn [{ json: { ok: true, collection: 'noavia_kb_v1', source, processing_log: [record] } }];"
      },
      "id": "noavia-kb-006",
      "name": "Audit KB Ingestion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [272, 80]
    }
  ],
  "connections": {
    "Manual Trigger - Ingest NOAVIA KB": { "main": [[{ "node": "Load NOAVIA Knowledge Files", "type": "main", "index": 0 }]] },
    "Load NOAVIA Knowledge Files": { "main": [[{ "node": "Document Loader - KB Markdown", "type": "main", "index": 0 }, { "node": "Qdrant Vector Store - Add Documents", "type": "main", "index": 0 }]] },
    "Document Loader - KB Markdown": { "ai_document": [[{ "node": "Qdrant Vector Store - Add Documents", "type": "ai_document", "index": 0 }]] },
    "Recursive Character Text Splitter - 800/120": { "ai_textSplitter": [[{ "node": "Document Loader - KB Markdown", "type": "ai_textSplitter", "index": 0 }]] },
    "Embeddings OpenAI - text-embedding-3-small": { "ai_embedding": [[{ "node": "Qdrant Vector Store - Add Documents", "type": "ai_embedding", "index": 0 }]] },
    "Qdrant Vector Store - Add Documents": { "main": [[{ "node": "Audit KB Ingestion", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true, "saveExecutionProgress": true }
}
