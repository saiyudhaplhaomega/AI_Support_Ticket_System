    },
    {
      "parameters": { "mode": "insert", "qdrantCollection": { "__rl": true, "value": "noavia_kb_v1", "mode": "id" }, "options": { "contentPayloadKey": "page_content", "metadataPayloadKey": "metadata" } },
      "id": "noavia-kb-webhook-005", "name": "Qdrant Vector Store - Update Documents", "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant", "typeVersion": 1.3, "position": [0, 80], "onError": "continueErrorOutput",
      "credentials": { "qdrantApi": { "id": "ErnjnpPFL91PNefY", "name": "Qdrant account" } }
    },
    {
      "parameters": { "model": "text-embedding-3-small", "options": { "dimensions": 1536 } },
      "id": "noavia-kb-webhook-006", "name": "Embeddings OpenAI - text-embedding-3-small", "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi", "typeVersion": 1.2, "position": [16, 304],
      "credentials": { "openAiApi": { "id": "XnFuXdyk9ZeJLNbi", "name": "OpenAI account" } }
    },
    {
      "parameters": { "jsCode": "const upload = $('Validate KB Upload').item.json.upload;\nreturn [{ json: { ok: true, data: { collection: upload.collection, source: upload.source, version: upload.version, status: 'indexed', message: 'Knowledge-base update accepted and indexed.' } } }];" },
      "id": "noavia-kb-webhook-007", "name": "Build KB Update Response", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [272, 80]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true, data: $json.data } }}", "options": { "responseCode": 200 } },
      "id": "noavia-kb-webhook-008", "name": "Respond KB Update Success", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.4, "position": [496, 80]
    },
    {
      "parameters": { "jsCode": "const detail = String($json.error?.message ?? 'Knowledge-base update failed.');\nconst validation = /multipart|Only \\.md|must be text|must be between/i.test(detail);\nreturn [{ json: { ok: false, error: { code: validation ? 'KB_UPLOAD_VALIDATION_ERROR' : 'KB_UPDATE_PROCESSING_ERROR', message: detail } } }];" },
      "id": "noavia-kb-webhook-009", "name": "Build KB Update Error", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-256, -96]
    },
