      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: false, error: $json.error } }}", "options": { "responseCode": "={{ $json.error.code === 'KB_UPLOAD_VALIDATION_ERROR' ? 400 : 502 }}" } },
      "id": "noavia-kb-webhook-010", "name": "Respond KB Update Error", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.4, "position": [-32, -96]
    }
