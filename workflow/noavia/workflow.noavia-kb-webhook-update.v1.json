      "id": "noavia-kb-webhook-001", "name": "Receive KB Update", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-720, 80], "webhookId": "noavia-kb-webhook-update-v1",
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_WITH_N8N_CREDENTIAL_ID", "name": "NOAVIA Ingest Header Auth" } }
    },
    {
      "parameters": { "jsCode": "const binary = $input.item.binary ?? {};\nconst file = binary.data;\nconst name = String(file?.fileName ?? '').trim();\nif (!file || !name) throw new Error('Upload one knowledge-base file in multipart field data.');\nif (!/\\.(md|markdown|txt)$/i.test(name)) throw new Error('Only .md, .markdown, and .txt knowledge-base files are accepted.');\nconst mime = String(file.mimeType ?? 'text/plain');\nif (!mime.startsWith('text/') && mime !== 'application/octet-stream') throw new Error('Knowledge-base file must be text.');\nconst encoded = String(file.data ?? '');\nconst padding = encoded.endsWith('==') ? 2 : encoded.endsWith('=') ? 1 : 0;\nconst declaredBytes = Number.parseInt(String(file.fileSize ?? file.size ?? ''), 10);\nconst bytes = encoded ? Math.floor(encoded.length * 3 / 4) - padding : declaredBytes;\nif (!Number.isFinite(bytes) || bytes < 1 || bytes > 5 * 1024 * 1024) throw new Error('Knowledge-base file must be between 1 byte and 5 MB.');\nconst receivedAt = new Date().toISOString();\nconst version = `${Date.now()}-${Math.random().toString(16).slice(2)}`;\nreturn [{ json: { upload: { source: name, version, bytes, received_at: receivedAt, collection: 'noavia_kb_v1' } }, binary }];" },
      "id": "noavia-kb-webhook-002", "name": "Validate KB Upload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-496, 80], "onError": "continueErrorOutput"
    },
    {
      "parameters": { "method": "POST", "url": "http://qdrant:6333/collections/noavia_kb_v1/points/delete?wait=true", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{ JSON.stringify({ filter: { must: [{ key: 'metadata.source', match: { value: $('Validate KB Upload').item.json.upload.source } }], must_not: [{ key: 'metadata.version', match: { value: $('Validate KB Upload').item.json.upload.version } }] } }) }}", "options": { "response": { "response": { "neverError": false, "responseFormat": "json" } }, "timeout": 30000 } },
      "id": "noavia-kb-webhook-011", "name": "Delete Previous Source Versions", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [272, 80], "onError": "continueErrorOutput"
    },
    {
      "parameters": { "dataType": "binary", "binaryMode": "allInputData", "loader": "textLoader", "textSplittingMode": "custom", "options": { "metadata": { "metadataValues": [ { "name": "source", "value": "={{ $('Validate KB Upload').item.json.upload.source }}" }, { "name": "version", "value": "={{ $('Validate KB Upload').item.json.upload.version }}" }, { "name": "collection", "value": "noavia_kb_v1" }, { "name": "ingestion", "value": "frontend-webhook" } ] } } },
      "id": "noavia-kb-webhook-003", "name": "Document Loader - Uploaded KB", "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader", "typeVersion": 1.1, "position": [-256, 224]
    },
