# Real secrets — never commit. Only .env.example is tracked.
.env
.env.*
!.env.example

# Caddy/n8n/Qdrant runtime state when bind-mounted locally instead of via
# named volumes (named volumes above are Docker-managed and not in this tree).
caddy_data/
caddy_config/
# Local preservation copy of the retired Caddy deployment. The canonical stack
# is docker-compose.yml and does not depend on this archive.
archive/legacy-caddy/

# classification-service local dev/test artifacts.
services/classification/__pycache__/
services/classification/**/__pycache__/
services/classification/.pytest_cache/
services/classification/.venv/

# Generated language/tool caches anywhere in the repository.
__pycache__/
*.py[cod]
.pytest_cache/

# Local runtime storage and database files. Docker named volumes are not in
# this checkout; these rules also protect bind-mounted equivalents.
data/
storage/
volumes/
*.db
*.sqlite
*.sqlite3

# Agent/session working directories. These capture raw n8n execution logs,
# which embed live request headers including Authorization bearer tokens.
# A leaked OpenAI key was found in .hermes/n8n-work/ during a security review.
.hermes/
.worktrees/

# Local Python environment at the repository root.
.venv/

# Generated fixtures and scratch output, not part of the submission.
output/
tmp/

# Interview preparation material. Working notes, not a deliverable.
interview-prep/

# NOAVIA-supplied hiring material. Never publish: the task document and the
# sample ERP export are the company's property, and the CSV carries
# personal-data-shaped contact records.
todo/
archive/
*.lnk

# Local dev scratch, superseded by scripts/verify_workflows.py.
scripts/diag-workflow.json
scripts/mock_classify_server.py
scripts/test-pdfs/
