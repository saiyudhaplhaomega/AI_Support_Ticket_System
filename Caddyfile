# HTTPS-ready reverse proxy config for the reverse-proxy service.
# Caddy issues/renews Let's Encrypt certs automatically for any domain block
# below — no manual cert management required.

{
	email {$INFRA_TLS_EMAIL}
}

# --- Production: public HTTPS route to n8n (webhooks + editor UI). ---
# Requires N8N_PUBLIC_DOMAIN to resolve to this host's public IP.
{$N8N_PUBLIC_DOMAIN} {
	# Reject oversize NOAVIA uploads at the public edge, before n8n buffers or
	# executes a workflow. `handle` preserves the complete webhook path.
	@noavia_ticket_upload path /webhook/noavia/tickets/v1
	handle @noavia_ticket_upload {
		request_body {
			max_size 10MB
		}
		reverse_proxy n8n:5678
	}

	# All other n8n routes retain the runtime's normal request-body behavior.
	handle {
		reverse_proxy n8n:5678
	}
}

# --- Local/dev alternative: no public DNS, self-signed cert. ---
# Comment out the block above and uncomment this one for local testing:
#
# localhost {
# 	tls internal
# 	reverse_proxy n8n:5678
# }

# Qdrant and classification-service are intentionally NOT routed here — they
# stay reachable only on the saas-internal network. Add a route only when a
# service genuinely needs public access, and prefer least exposure (e.g. a
# path-scoped route) over a bare domain block.
