# infra.secrets-and-network.v1 — env var contract
#
# Copy this file to `.env` next to docker-compose.yml and fill in real values.
# `.env` is git-ignored — never commit real secrets. This file only documents
# names and shapes; every value here is a placeholder.
#
# Naming convention (per capability-module-architecture.md §4):
#   <FAMILY>_<PURPOSE>, upper snake case, no product name baked in.
#   Product-specific values (e.g. NOAVIA's Sheet ID) are passed as n8n workflow
#   input at runtime, not stored as global env vars here.

# ---- infra.* — networking & platform ----
INFRA_NETWORK_NAME=saas-internal
INFRA_TIMEZONE=UTC
INFRA_LOG_LEVEL=info
# Email used for Let's Encrypt account registration (Caddy automatic HTTPS).
INFRA_TLS_EMAIL=ops@example.com

# ---- Public ingress ----
# Domain that resolves to this host; reverse-proxy issues/renews its HTTPS cert
# for this name automatically. Use a real DNS-resolvable domain in production.
N8N_PUBLIC_DOMAIN=n8n.example.com

# ---- n8n (workflow.* runtime) ----
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
# 32+ char random string; used to encrypt stored n8n credentials at rest.
N8N_ENCRYPTION_KEY=change-me-32-char-random-string

# ---- ai.* module secrets ----
# §7 open question resolved: ai.classify-ticket.v1 / ai.rag-lookup.v1 ship as
# a standalone HTTP service (services/classification), run via
# `docker compose --profile classification-service up`. n8n calls it over
# HTTP on saas-internal instead of via an Execute Workflow node.
# AI_CLASSIFY_API_KEY does double duty: n8n's HTTP Request node sends it as
# `Authorization: Bearer $AI_CLASSIFY_API_KEY`, and the classification
# service checks incoming requests against the same value — one shared
# secret, one name, per the "no new secret name for the same purpose" rule.
AI_CLASSIFY_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
# Qdrant's admin/signing secret. It is injected only into the qdrant container,
# never into application containers. Use a long random value from the secret
# store; changing it invalidates issued Qdrant JWTs.

# ---- ai.* module tuning (optional; classification-service has sensible
# built-in defaults for all of these — set only to override) ----
AI_EMBEDDING_PROVIDER=openai
AI_CHAT_PROVIDER=minimax
AI_EMBEDDING_MODEL=text-embedding-3-small
# Only needed if you want to truncate embeddings to fewer dimensions
# (matryoshka models). Leave blank to use the model's native size.
AI_EMBEDDING_DIMENSIONS=
AI_CHAT_MODEL=MiniMax-M3
AI_UPSTREAM_TIMEOUT_SECONDS=8
# Default Qdrant collection ai.rag-lookup.v1 reads from and ingestion writes
# to when a caller doesn't pass an explicit `collection` field.
AI_RAG_COLLECTION=kb_documents
AI_RAG_TOP_K_DEFAULT=5
AI_RAG_TOP_K_MAX=50
# Default support-ticket taxonomy ai.classify-ticket.v1 uses when a caller
# doesn't pass `context.categories`. Comma-separated, no spaces required.
AI_CLASSIFY_CATEGORIES_DEFAULT=billing,technical,account,feature_request,complaint,other
# Qdrant authentication is enabled by default. Set false only when the configured
# Qdrant deployment has authentication disabled. In that mode, leave
# AI_QDRANT_API_KEY blank. Do not disable it merely to bypass a missing key.
AI_QDRANT_AUTH_ENABLED=false
# Required when AI_QDRANT_AUTH_ENABLED=true. Store a short-lived Qdrant JWT with
# collection-scoped `rw` access (normally AI_RAG_COLLECTION), signed with
# QDRANT_SERVICE_API_KEY. This is the only Qdrant credential injected into an
# application container; n8n does not receive Qdrant access.
AI_QDRANT_API_KEY=

# ---- notify.* output node: Gmail ----
# Select the Gmail OAuth2 credential in n8n. Its authorized Gmail identity is
# the sender; the workflow does not accept a sender address from ticket input.
# Server-side only JSON category-to-recipient allow-list. For the approved
# offline/test configuration every value must be the same approved sink inbox.
# Never supply these values in a ticket request.
# Example: {"default":"noavia-test-sink@example.invalid","billing":"noavia-test-sink@example.invalid","manual_review":"noavia-test-sink@example.invalid"}
NOAVIA_NOTIFY_ROUTE_ALLOWLIST_JSON=

# ---- NOAVIA test-only product boundary ----
# The workflow export stays inactive. The frontend holds no credential values;
# this token exists only between the private frontend and n8n webhook binding.
NOAVIA_TEST_MODE=true
NOAVIA_TEST_SHEET_NAME=NOAVIA Support Tickets - Test
NOAVIA_INTERNAL_WEBHOOK_TOKEN=replace-with-a-private-random-token

# ---- notify.* output nodes: Google Sheets ----
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
